function fillQuickDimSelects(rowIndex, productRow) {
  // productRow = rekord z closed-products.csv dla wybranego elementu
  const sSel = document.querySelector(`select[data-t="quick"][data-i="${rowIndex}"][data-f="s"]`);
  const lSel = document.querySelector(`select[data-t="quick"][data-i="${rowIndex}"][data-f="l"]`);
  const wSel = document.querySelector(`select[data-t="quick"][data-i="${rowIndex}"][data-f="w"]`);
  const gSel = document.querySelector(`select[data-t="quick"][data-i="${rowIndex}"][data-f="g"]`);

  const sOpts = splitDims(productRow?.width);
  const lOpts = splitDims(productRow?.length);
  const wOpts = splitDims(productRow?.height);
  const gOpts = splitDims(productRow?.thickness);

  // wartości ze stanu (żeby po odświeżeniu nie znikały)
  const st = state.quick[rowIndex] || {};

  setSelectOptions(sSel, sOpts, st.s ?? "");
  setSelectOptions(lSel, lOpts, st.l ?? "");
  setSelectOptions(wSel, wOpts, st.w ?? "");
  setSelectOptions(gSel, gOpts, st.g ?? "");
}


  function num(x) {
    if (x === null || x === undefined) return 0;
    const s = String(x).replace(/\s/g, "").replace(",", ".").replace("zł","").replace("PLN","").replace("€","").trim();
    const n = parseFloat(s);
    return Number.isFinite(n) ? n : 0;
  }

function parseMarginPercent(v) {
  // "30", "30%", " 30 %" => 30
  let s = String(v ?? "").trim();
  s = s.replace("%", "").trim();
  s = s.replace(",", ".");
  const n = parseFloat(s);
  return Number.isFinite(n) ? n : 0;
}

function formatMarginPercent(v) {
  let s = String(v ?? "").trim();
  if (!s) return "";
  s = s.replace("%", "").trim();
  return s ? `${s}%` : "";
}

function recalcSaleFromMargin(valId, marginId, saleId) {
  const val = num(document.getElementById(valId)?.value);
  const m = parseMarginPercent(document.getElementById(marginId)?.value);
  const saleEl = document.getElementById(saleId);
  if (!saleEl) return;

  const sale = val * (1 + (m / 100));
  saleEl.value = sale.toFixed(2);
}

function renderComputed() {
  // PL
  let plTotalW = 0, plTotalV = 0;
  document.querySelectorAll("#plTable tbody tr").forEach(tr => {
    const qty   = num(tr.querySelector('input[data-t="pl"][data-f="qty"]')?.value);
