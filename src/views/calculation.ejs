  <script>
function renderOfferSummary() {
  const frVal = num(document.getElementById("frTotalValue")?.value); // EUR
  const plVal = num(document.getElementById("plTotalValue")?.value); // PLN (PL tabela)

  // EUR w podsumowaniu
  const valEurEl = document.getElementById("sum_val_eur");
  if (valEurEl) valEurEl.value = frVal.toFixed(2);

  // szybka oferta: towar + transport + montaż
  let qGoods = 0;
  let qTotalTransport = 0;
  let qTotalAssembly = 0;

  document.querySelectorAll("#quickTable tbody tr").forEach(tr => {
    const qtyNeed = num(tr.querySelector('input[data-t="quick"][data-f="qtyNeed"]')?.value);
    const salePrice = num(tr.querySelector('input[data-t="quick"][data-f="salePrice"]')?.value);
    const transport = num(tr.querySelector('input[data-t="quick"][data-f="transport"]')?.value);
    const assembly  = num(tr.querySelector('input[data-t="quick"][data-f="assembly"]')?.value);

    qGoods += qtyNeed * salePrice;
    qTotalTransport += transport;
    qTotalAssembly += assembly;
  });

  // PLN w podsumowaniu = PL tabela + towar z szybkiej oferty (bez transportu/montażu)
  const plTotal = plVal + qGoods; //+ qTotalTransport + qTotalAssembly;

  const valPlnEl = document.getElementById("sum_val_pln");
  if (valPlnEl) valPlnEl.value = plTotal.toFixed(2);

  // Transport i montaż w podsumowaniu z szybkiej oferty
  const trnEl = document.getElementById("sum_val_trn");
  const mntEl = document.getElementById("sum_val_mnt");
  if (trnEl) trnEl.value = qTotalTransport.toFixed(2);
  if (mntEl) mntEl.value = qTotalAssembly.toFixed(2);

  // SUMA sprzedaży (wpisywana ręcznie)
  const saleIds = ["sum_sale_eur","sum_sale_pln","sum_sale_srv","sum_sale_mnt","sum_sale_trn"];
  const totalSale = saleIds.map(id => num(document.getElementById(id)?.value)).reduce((a,b)=>a+b,0);

  const totalSaleEl = document.getElementById("sum_sale_total");
  if (totalSaleEl) totalSaleEl.value = totalSale.toFixed(2);

  // marża końcowa
  const fxEur = num(document.getElementById("sum_fx_eur")?.value);
  const cost =
    (frVal * fxEur) +
    plTotal +
    num(document.getElementById("sum_val_srv")?.value) +
    qTotalAssembly +
    qTotalTransport;

  const marginTotalEl = document.getElementById("sum_margin_total");
  if (marginTotalEl) {
    const m = totalSale > 0 ? ((totalSale - cost) / totalSale) * 100 : 0;
    marginTotalEl.value = m.toFixed(2);
  }
  // przelicz ceny sprzedaży z marży (wartość * (1 + marża/100))
  recalcSaleFromMargin("sum_val_eur", "sum_margin_eur", "sum_sale_eur");
  recalcSaleFromMargin("sum_val_pln", "sum_margin_pln", "sum_sale_pln");
  recalcSaleFromMargin("sum_val_srv", "sum_margin_srv", "sum_sale_srv");
  recalcSaleFromMargin("sum_val_mnt", "sum_margin_mnt", "sum_sale_mnt");
  recalcSaleFromMargin("sum_val_trn", "sum_margin_trn", "sum_sale_trn");  
}

    
