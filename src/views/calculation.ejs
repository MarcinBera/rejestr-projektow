    const unitP = num(tr.querySelector('input[data-t="pl"][data-f="unitPrice"]')?.value);

    const wT = (qty * unitW) / 1000;
    const v  = qty * unitP;

    const outW = tr.querySelector('input[data-out="plWeightT"]');
    const outV = tr.querySelector('input[data-out="plValue"]');

    if (outW) outW.value = wT.toFixed(3);
    if (outV) outV.value = v.toFixed(2);

