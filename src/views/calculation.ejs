window.saveAll = async function() {
  // const info = document.getElementById("saveInfo");
  const info = document.getElementById("saveInfo") || document.getElementById("saveInfoTop");

  info.textContent = "Zapisuję...";

  try {
    // zsynchronizuj state z inputami
    document.querySelectorAll("input[data-t]").forEach(inp => {
      const t = inp.dataset.t;
      const i = parseInt(inp.dataset.i, 10);
      const f = inp.dataset.f;
      if (!state[t][i]) state[t][i] = {};
      state[t][i][f] = inp.value;
    });

    const payload = {
      status: document.getElementById("hdrStatus")?.value,
      turnover: document.getElementById("hdrTurnover")?.value ?? "",
      offerType: document.getElementById("hdrOfferType")?.value ?? "",
      plItems: state.pl,
      foreignItems: state.foreign,
      quickOffer: state.quick,
    };

    payload.summary = {
  fxEur: document.getElementById("sum_fx_eur")?.value ?? "",
  fxPln: document.getElementById("sum_fx_pln")?.value ?? "",
  fxSrv: document.getElementById("sum_fx_srv")?.value ?? "",
  fxMnt: document.getElementById("sum_fx_mnt")?.value ?? "",
  fxTrn: document.getElementById("sum_fx_trn")?.value ?? "",

  // wartości EUR/PLN są readonly, ale zapisujemy je tak czy siak:
  valEur: document.getElementById("sum_val_eur")?.value ?? "",
  valPln: document.getElementById("sum_val_pln")?.value ?? "",
  valSrv: document.getElementById("sum_val_srv")?.value ?? "",
  valMnt: document.getElementById("sum_val_mnt")?.value ?? "",
  valTrn: document.getElementById("sum_val_trn")?.value ?? "",

  marginEur: document.getElementById("sum_margin_eur")?.value ?? "",
  marginPln: document.getElementById("sum_margin_pln")?.value ?? "",
  marginSrv: document.getElementById("sum_margin_srv")?.value ?? "",
  marginMnt: document.getElementById("sum_margin_mnt")?.value ?? "",
  marginTrn: document.getElementById("sum_margin_trn")?.value ?? "",

  saleEur: document.getElementById("sum_sale_eur")?.value ?? "",
  salePln: document.getElementById("sum_sale_pln")?.value ?? "",
  saleSrv: document.getElementById("sum_sale_srv")?.value ?? "",
  saleMnt: document.getElementById("sum_sale_mnt")?.value ?? "",
  saleTrn: document.getElementById("sum_sale_trn")?.value ?? "",

  saleTotal: document.getElementById("sum_sale_total")?.value ?? "",
  marginTotal: document.getElementById("sum_margin_total")?.value ?? ""
};


    console.log("SAVE payload:", payload);

    const url = `/calculations/${calcId}/save`;
    console.log("POST", url);

    const resp = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });

    console.log("RESP status:", resp.status);

    const data = await resp.json().catch(() => null);
    console.log("RESP json:", data);

    if (resp.ok && data && data.ok) {
      info.textContent = "Zapisano.";
    } else {
      info.textContent = "Błąd zapisu.";
    }
  } catch (e) {
    console.error(e);
    info.textContent = "Błąd JS (sprawdź Console).";
  }
};


