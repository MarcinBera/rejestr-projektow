  function setSelectOptions(sel, opts, current) {
  if (!sel) return;

  const cur = (current ?? "").toString().trim();

  sel.innerHTML = "";

  const empty = document.createElement("option");
  empty.value = "";
  empty.textContent = "";
  sel.appendChild(empty);

  for (const raw of (opts || [])) {
    const v = (raw ?? "").toString().trim();
    if (!v) continue;
    const opt = document.createElement("option");
    opt.value = v;
    opt.textContent = v;
    sel.appendChild(opt);
  }

  // ustaw wybraną wartość (tylko jeśli istnieje w opcjach)
  const has = Array.from(sel.options).some(o => o.value === cur);
  sel.value = has ? cur : "";
}

