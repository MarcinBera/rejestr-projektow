          </td>

          <!-- ELEMENT (z closed-products) -->
          <td>
            <input list="closedProductsList"
                   data-t="quick" data-i="<%= idx %>" data-f="element"
                   value="<%= it.element ?? '' %>">
          </td>

          <!-- WYMIARY jako SELECT -->
          <td>
            <select data-t="quick" data-i="<%= idx %>" data-f="s"></select>
          </td>
          <td>
            <select data-t="quick" data-i="<%= idx %>" data-f="l"></select>
          </td>
          <td>
            <select data-t="quick" data-i="<%= idx %>" data-f="w"></select>
          </td>
          <td>
            <select data-t="quick" data-i="<%= idx %>" data-f="g"></select>
          </td>

